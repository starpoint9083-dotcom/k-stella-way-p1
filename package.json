{
  "name": "k-stella-shorts-factory",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assemble": "node scripts/assemble-source.mjs",
    "patch:free": "node scripts/patch-free-mode.mjs",
    "patch:lineup-timeout": "node scripts/patch-lineup-timeout.mjs",
    "patch:media-timeouts": "node scripts/patch-media-timeouts.mjs",
    "patch:tts-audio": "node scripts/patch-tts-audio-validation.mjs",
    "patch:asset-reuse": "node scripts/patch-free-asset-reuse.mjs",
    "patch:queue-resume": "node scripts/patch-production-queue-resume.mjs",
    "patch:owned-music": "node scripts/patch-owned-procedural-music.mjs",
    "check": "npm run assemble && npm run patch:free && npm run patch:lineup-timeout && npm run patch:media-timeouts && npm run patch:tts-audio && npm run patch:asset-reuse && npm run patch:queue-resume && npm run patch:owned-music && node --check src/index.js",
    "preflight": "node scripts/preflight.mjs && node scripts/preflight-owned-music.mjs",
    "generate:wrangler": "node scripts/generate-wrangler.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.38.0"
  }
}
