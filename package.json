{
  "name": "k-stella-shorts-factory",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assemble": "node scripts/assemble-source.mjs",
    "patch:free": "node scripts/patch-free-mode.mjs",
    "patch:lineup-timeout": "node scripts/patch-lineup-timeout.mjs",
    "patch:asset-reuse": "node scripts/patch-free-asset-reuse.mjs",
    "check": "npm run assemble && npm run patch:free && npm run patch:lineup-timeout && npm run patch:asset-reuse && node --check src/index.js",
    "preflight": "node scripts/preflight.mjs",
    "generate:wrangler": "node scripts/generate-wrangler.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.38.0"
  }
}
